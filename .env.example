# Copier en .env (jamais versionné) pour surcharger les valeurs par défaut.

# Serveur MLflow pour une exécution hors Docker ; sans valeur, le suivi se fait dans ./mlruns.
MLFLOW_TRACKING_URI=

# Docker Compose
MLFLOW_PORT=5000
IMAGE_TAG=local
# Utilisateur du conteneur pipeline (Linux : mettre le résultat de `id -u` et `id -g`).
HOST_UID=999
HOST_GID=999
